# LicenseGate GitHub App — 环境变量示例
# 复制为 .env 后填入真实值：  cp .env.example .env

# —— GitHub App 身份 ——
# 在 https://github.com/settings/apps 新建 App 后填入（仅占位也能启动，收到 webhook 时才真正使用）
APP_ID=
# 私钥二选一：直接贴 PEM 内容，或给出文件路径
PRIVATE_KEY=
PRIVATE_KEY_PATH=

# —— Webhook 签名密钥 ——
# 在 App 设置页 "Webhook secret" 中生成，服务端用它校验 x-hub-signature-256
WEBHOOK_SECRET=

# —— 服务 ——
PORT=3000
DATABASE_PATH=./data/licensegate.db

# —— 仪表盘 Basic Auth（留空则不设密码，启动时会打印警告）——
DASHBOARD_USER=
DASHBOARD_PASS=

# —— 计费 ——
# "true" 时按 GitHub Marketplace 订阅查计划；默认 "false" 全部按免费版（限 1 个仓库）
BILLING_ENABLED=false

# —— 仅测试用：设为 1 则 GitHub API 走 fixture mock ——
# GITHUB_API_MOCK=1
